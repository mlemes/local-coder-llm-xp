{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "local-coder": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local Coder",
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1",
        "apiKey": "{env:LOCAL_CODER_API_KEY}"
      },
      "models": {
        "qwen3-coder": {
          "name": "Qwen3 Coder 30B-A3B",
          "limit": { "context": 65536, "output": 8192 }
        }
      }
    }
  }
}
